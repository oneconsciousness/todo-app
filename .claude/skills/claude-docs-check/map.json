{
  "bases": [
    "main",
    "round/*"
  ],
  "artifact_prefixes": [
    ".claude/rules/",
    ".claude/skills/",
    ".claude/agents/",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "backend/CLAUDE.md",
    "frontend/CLAUDE.md"
  ],
  "triggers": [
    {
      "paths": [
        ".github/workflows/*",
        "scripts/*",
        "docker-compose*.yml",
        "*/Dockerfile",
        "deploy/*",
        "frontend/nginx.conf"
      ],
      "artifacts": [
        "CLAUDE.md (Branches and deploy)",
        ".claude/rules/deployment.md",
        ".claude/rules/git-and-prs.md",
        "CONTRIBUTING.md (section 1)"
      ]
    },
    {
      "paths": [
        "docker-compose*.yml",
        "e2e/*",
        "load/*"
      ],
      "artifacts": [
        "CLAUDE.md (Commands, Gotchas)"
      ]
    },
    {
      "paths": [
        "backend/pyproject.toml",
        "backend/uv.lock",
        "backend/app/config.py",
        "backend/app/main.py",
        "backend/Dockerfile",
        "backend/app/log.py"
      ],
      "artifacts": [
        "backend/CLAUDE.md (Commands, Config, Where things are)"
      ]
    },
    {
      "paths": [
        "backend/app/api/*",
        "frontend/src/lib/api/*",
        "frontend/src/lib/schema/*"
      ],
      "artifacts": [
        ".claude/rules/api-contract.md"
      ]
    },
    {
      "paths": [
        "backend/alembic/*",
        "backend/app/db/*"
      ],
      "artifacts": [
        ".claude/rules/database.md"
      ]
    },
    {
      "paths": [
        "backend/tests/conftest.py",
        "frontend/src/test/*",
        "frontend/vitest.config.ts",
        "e2e/browser/playwright.config.ts",
        "e2e/*",
        "load/*"
      ],
      "artifacts": [
        ".claude/rules/testing.md",
        ".claude/skills/verify/SKILL.md"
      ]
    },
    {
      "paths": [
        "frontend/package.json",
        "frontend/package-lock.json",
        "frontend/vite.config.ts",
        "frontend/tsconfig.json",
        "frontend/eslint.config.js",
        "frontend/Dockerfile",
        "frontend/nginx.conf",
        "frontend/src/main.tsx"
      ],
      "artifacts": [
        "frontend/CLAUDE.md (Commands, Config, Where things are)"
      ]
    },
    {
      "paths": [
        ".claude/hooks/*",
        ".claude/settings.json"
      ],
      "artifacts": [
        "CONTRIBUTING.md (sections 8.4 and 12)",
        "CLAUDE.md (Config and secrets, Branches and deploy)"
      ]
    }
  ]
}
